    # else
    #     mkdir -p "$repo_dir"
    #     git clone --mirror "https://github.com/$repo.git" "$bare_repo_path"
    #     ln -sf "$bare_repo_path" /home/git
    # fi

    # (cd "$GIT_DIR"; "$BIN_DIR"/update-git-repo "$repo_dir")
done

